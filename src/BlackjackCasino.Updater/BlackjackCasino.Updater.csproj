<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The updater reports failures through a native dialog and a durable log.
         It must not flash and silently close a console window. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Description>Out-of-process atomic updater for Blackjack Casino.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlackjackCasino.Update\BlackjackCasino.Update.csproj" />
  </ItemGroup>
</Project>
