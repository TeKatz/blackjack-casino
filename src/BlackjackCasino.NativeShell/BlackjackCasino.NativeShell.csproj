  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../BlackjackCasino.Assets/Music/*.wav"
      LogicalName="BlackjackCasino.Music.%(Filename)%(Extension)" />
    <None Include="../BlackjackCasino.Assets/Music/Licensed/*.mp3"
      Link="Music/Licensed/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../frontend/dist/**/*"
             Link="ModernFrontend/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="Exists('../../frontend/dist/index.html')" />
    <None Include="../BlackjackCasino.Assets/Empire/*.png"
          Link="ModernFrontend/empire-art/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../BlackjackCasino.Assets/NineLives/*.jpg"
          Link="ModernFrontend/nine-lives-art/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
