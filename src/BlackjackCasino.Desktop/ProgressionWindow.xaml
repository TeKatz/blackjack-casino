<Window x:Class="BlackjackCasino.Desktop.ProgressionWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackjack Casino — Profile &amp; Progression"
        Width="1120" Height="780" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#07120D" Foreground="#F2EEE4" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#123322" />
      <Setter Property="Foreground" Value="#F2EEE4" />
      <Setter Property="BorderBrush" Value="#466552" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#E0B65A" /><Setter Property="Background" Value="#19472F" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#DCE6DF" />
      <Setter Property="Background" Value="#0D2218" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="#B30B2117" />
      <Setter Property="BorderBrush" Value="#315A43" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="6" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <Border x:Name="ProfileFrame" Padding="18" CornerRadius="12" BorderThickness="2" Background="#0B2117" BorderBrush="#D4A84F" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TitleText" FontSize="27" FontWeight="Bold" Foreground="#FFE09B" />
          <TextBlock x:Name="LevelText" FontSize="14" Foreground="#B6C8BC" Margin="0,4,0,0" />
          <Grid Margin="0,12,0,0" MaxWidth="650" HorizontalAlignment="Left">
            <ProgressBar x:Name="LevelProgress" Width="650" Height="16" Minimum="0" Maximum="1" Background="#173729" Foreground="#D4A84F" />
            <TextBlock x:Name="LevelProgressText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FFF8E8" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock x:Name="CoinsText" FontSize="22" FontWeight="Bold" Foreground="#FFD77C" HorizontalAlignment="Right" />
          <Button x:Name="PrestigeButton" Content="Enter Prestige" Margin="0,12,0,0" Click="PrestigeButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Background="#07120D" BorderBrush="#315A43">
      <TabItem Header="Overview">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="LIFETIME" FontWeight="Bold" Foreground="#FFD77C" /><TextBlock x:Name="LifetimeStatsText" Margin="0,10,0,0" LineHeight="24" /></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="THIS SESSION" FontWeight="Bold" Foreground="#FFD77C" /><TextBlock x:Name="SessionStatsText" Margin="0,10,0,0" LineHeight="24" /></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="TABLE PERFORMANCE" FontWeight="Bold" Foreground="#FFD77C" /><StackPanel x:Name="TableStatsPanel" Margin="0,8,0,0" /></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Hand History">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HistoryPanel" Margin="8" /></ScrollViewer>
      </TabItem>

      <TabItem Header="Season Pass">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock x:Name="SeasonTitleText" FontSize="23" FontWeight="Bold" Foreground="#FFD77C" />
              <TextBlock x:Name="SeasonDescriptionText" Margin="0,5,0,0" Foreground="#AFC3B6" TextWrapping="Wrap" />
              <TextBlock x:Name="SeasonTierText" Margin="0,12,0,5" FontWeight="SemiBold" />
              <ProgressBar x:Name="SeasonProgress" Height="16" Minimum="0" Maximum="100" Background="#173729" Foreground="#6E75D8" />
              <TextBlock Text="One free track. No premium tier. Seasons remain available from your library." Margin="0,8,0,0" FontSize="11" Foreground="#819A8A" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SeasonRewardsPanel" Margin="8" /></ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Cosmetic Shop">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="6"><TextBlock x:Name="ShopCoinsText" FontSize="18" FontWeight="Bold" Foreground="#FFD77C" /><TextBlock x:Name="ShopStatusText" Margin="18,3,0,0" Foreground="#B7C9BD" /></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ShopPanel" Margin="8" /></ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
