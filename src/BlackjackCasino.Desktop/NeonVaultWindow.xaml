<Window x:Class="BlackjackCasino.Desktop.NeonVaultWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neon Vault"
        Width="1600"
        Height="960"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#05050B"
        Foreground="#F4F5FF"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_KeyDown"
        Closed="Window_Closed">
  <Window.Resources>
    <!-- High-contrast, layered glass and anodized-metal materials. -->
    <LinearGradientBrush x:Key="VaultGlassPanel" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F1152144" Offset="0"/>
      <GradientStop Color="#F40B122A" Offset="0.40"/>
      <GradientStop Color="#F30A0B21" Offset="0.76"/>
      <GradientStop Color="#F01B103C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VaultChrome" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#218CFF" Offset="0"/>
      <GradientStop Color="#C259FF" Offset="0.27"/>
      <GradientStop Color="#64F4FF" Offset="0.59"/>
      <GradientStop Color="#812CDA" Offset="0.85"/>
      <GradientStop Color="#23D7FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VaultButtonFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#334776" Offset="0"/>
      <GradientStop Color="#15243F" Offset="0.18"/>
      <GradientStop Color="#091327" Offset="0.84"/>
      <GradientStop Color="#32234D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VaultSpinFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2C4D9C" Offset="0"/>
      <GradientStop Color="#451E73" Offset="0.36"/>
      <GradientStop Color="#8A248C" Offset="0.70"/>
      <GradientStop Color="#273CA7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VaultReelBed" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#181640" Offset="0"/>
      <GradientStop Color="#081326" Offset="0.37"/>
      <GradientStop Color="#0B0B22" Offset="0.70"/>
      <GradientStop Color="#21134E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="VaultInk" Color="#F4F5FF" />
    <SolidColorBrush x:Key="VaultMuted" Color="#8C91B2" />
    <SolidColorBrush x:Key="VaultCyan" Color="#4DEBFF" />
    <SolidColorBrush x:Key="VaultViolet" Color="#8A63FF" />
    <SolidColorBrush x:Key="VaultGold" Color="#FFD56A" />
    <SolidColorBrush x:Key="VaultRed" Color="#FF4D72" />

    <Style x:Key="VaultButton" TargetType="Button">
      <Setter Property="Foreground" Value="#EEF2FF" />
      <Setter Property="Background" Value="{StaticResource VaultButtonFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource VaultChrome}" />
      <Setter Property="BorderThickness" Value="1.7" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <Grid>
                <Border Margin="3" CornerRadius="7" BorderBrush="#397EDFFF" BorderThickness="1" IsHitTestVisible="False" />
                <Border Margin="13,5,13,0" Height="1.6" VerticalAlignment="Top"
                        Background="#79CEFCFF" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E8FBFF" />
                <Setter TargetName="Chrome" Property="Background" Value="#29427B" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.34" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SpinButtonStyle" TargetType="Button" BasedOn="{StaticResource VaultButton}">
      <Setter Property="Background" Value="{StaticResource VaultSpinFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource VaultChrome}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="MinWidth" Value="244" />
      <Setter Property="Padding" Value="28,17" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="SpinGlass" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="3" CornerRadius="15">
                <Border.Effect>
                  <DropShadowEffect Color="#D536EC" BlurRadius="18" ShadowDepth="0" Opacity="0.48"/>
                </Border.Effect>
              </Border>
              <Border Margin="5" CornerRadius="10" BorderBrush="#7FDBF9FF"
                      BorderThickness="1" Background="#150F0A2C" IsHitTestVisible="False"/>
              <Border Margin="23,8,23,0" Height="2" VerticalAlignment="Top"
                      Background="#8EF6FCFF" IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SpinGlass" Property="BorderBrush" Value="#F3FFFF"/>
                <Setter TargetName="SpinGlass" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="SpinGlass" Property="Opacity" Value="0.67"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SpinGlass" Property="Opacity" Value="0.36"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="VaultToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DAE9FF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="9,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="CheckFrame" Width="18" Height="18" VerticalAlignment="Center"
                      CornerRadius="4" Background="#13203A" BorderBrush="#5284BD" BorderThickness="1.5"/>
              <Path x:Name="CheckMark" Grid.Column="0"
                    Data="M 3,9 L 7,13 15,4" Stroke="#C9FCFF" StrokeThickness="2.6"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="17" Height="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
              <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckFrame" Property="Background" Value="#1D5C84"/>
                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#65F4FF"/>
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#EAA3FF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CheckFrame" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="VaultEnergyBar" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="#4FEFFF"/>
      <Setter Property="Background" Value="#10182C"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                      BorderBrush="#3B6087" BorderThickness="1" CornerRadius="6"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      BorderBrush="#B8F9FF" BorderThickness="1" CornerRadius="5">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B6FFFF" Offset="0"/>
                    <GradientStop Color="#43DFFF" Offset="0.28"/>
                    <GradientStop Color="#2975F7" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="JackpotCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource VaultGlassPanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource VaultChrome}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18,11,18,12" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="#05050B" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource VaultGlassPanel}" BorderBrush="#4BBAE8" BorderThickness="0,0,0,2" Panel.ZIndex="20">
      <Grid Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Grid.Column="0" Content="←  LOBBY" Style="{StaticResource VaultButton}" Margin="0,10,18,10" Click="Back_Click" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="NEON VAULT" FontSize="27" FontWeight="Bold" Foreground="#A5F8FF">
            <TextBlock.Effect><DropShadowEffect Color="#43D4FF" BlurRadius="15" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock Text="BREAK THE SYSTEM  ·  CRACK THE VAULT" FontSize="9" Foreground="#6DE8FF" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="24,0" VerticalAlignment="Center">
          <TextBlock Text="BANKROLL" FontSize="9" Foreground="#727A9D" HorizontalAlignment="Right" />
          <TextBlock x:Name="BalanceText" FontSize="18" FontWeight="Bold" Foreground="#FFD978" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center">
          <TextBlock Text="PROFILE" FontSize="9" Foreground="#727A9D" HorizontalAlignment="Right" />
          <TextBlock x:Name="ProfileText" FontSize="11" Foreground="#C8CDE4" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid x:Name="NeonVaultStage" Width="1600" Height="850" Background="#060712" ClipToBounds="True">
        <Rectangle IsHitTestVisible="False">
          <Rectangle.Fill>
            <RadialGradientBrush RadiusX="0.8" RadiusY="0.8" Center="0.5,0.42" GradientOrigin="0.5,0.42">
              <GradientStop Color="#302668" Offset="0" />
              <GradientStop Color="#121A3C" Offset="0.42" />
              <GradientStop Color="#060712" Offset="1" />
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <Ellipse x:Name="AmbientGlow"
                 Width="1360"
                 Height="680"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.27"
                 IsHitTestVisible="False">
          <Ellipse.CacheMode><BitmapCache RenderAtScale="0.65" /></Ellipse.CacheMode>
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#5A42A8FF" Offset="0" />
              <GradientStop Color="#152E1A68" Offset="0.55" />
              <GradientStop Color="#00050B12" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>

        <Rectangle x:Name="Scanline"
                   Width="1480"
                   Height="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,80,0,0"
                   Fill="#6AEFFF"
                   Opacity="0.17"
                   IsHitTestVisible="False">
          <Rectangle.RenderTransform>
            <TranslateTransform x:Name="ScanlineTransform" />
          </Rectangle.RenderTransform>
        </Rectangle>

        <!-- Vault chamber rails: machine-frame depth without non-interactive overlays blocking controls. -->
        <Canvas Width="1600" Height="850" IsHitTestVisible="False" ClipToBounds="True">
          <Canvas.CacheMode><BitmapCache RenderAtScale="0.85" /></Canvas.CacheMode>
          <Path Data="M 22,210 L 22,65 150,20 M 1578,210 L 1578,65 1450,20"
                Stroke="#6E45EFFF" StrokeThickness="5" Opacity="0.55"/>
          <Path Data="M 16,615 L 16,780 168,834 M 1584,615 L 1584,780 1432,834"
                Stroke="#A0C54BFF" StrokeThickness="4" Opacity="0.5"/>
          <Path Data="M 180,8 L 550,8 M 1050,8 L 1420,8"
                Stroke="#6A7E65FF" StrokeThickness="3"/>
          <Ellipse Canvas.Left="680" Canvas.Top="-185" Width="240" Height="240"
                   Stroke="#9C7849FF" StrokeThickness="17" Opacity="0.36"/>
          <Ellipse Canvas.Left="720" Canvas.Top="-145" Width="160" Height="160"
                   Stroke="#9E55EFFF" StrokeThickness="6" Opacity="0.30"/>
        </Canvas>
        <Grid Margin="28,18,28,21">
          <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="106" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource JackpotCard}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="14" />
                  <RowDefinition Height="22" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ACCESS LEVEL I" FontSize="9" Foreground="#7E8AAE" />
                <TextBlock Grid.Row="1" Text="MINI" FontSize="13" FontWeight="Bold" Foreground="#9EEBFF" />
                <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxHeight="28">
                  <TextBlock x:Name="MiniJackpotText" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                </Viewbox>
              </Grid>
            </Border>

            <Border Grid.Column="1" Margin="8,0" Style="{StaticResource JackpotCard}" BorderBrush="#55518E">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="14" />
                  <RowDefinition Height="22" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ACCESS LEVEL II" FontSize="9" Foreground="#8780AF" />
                <TextBlock Grid.Row="1" Text="MINOR" FontSize="13" FontWeight="Bold" Foreground="#B9A6FF" />
                <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxHeight="28">
                  <TextBlock x:Name="MinorJackpotText" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                </Viewbox>
              </Grid>
            </Border>

            <Border Grid.Column="2" Margin="8,0" Style="{StaticResource JackpotCard}" BorderBrush="#80662C">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="14" />
                  <RowDefinition Height="22" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ACCESS LEVEL III" FontSize="9" Foreground="#A28B56" />
                <TextBlock Grid.Row="1" Text="MAJOR" FontSize="13" FontWeight="Bold" Foreground="#FFD66E" />
                <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxHeight="28">
                  <TextBlock x:Name="MajorJackpotText" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                </Viewbox>
              </Grid>
            </Border>

            <Border Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource JackpotCard}" Background="#E3161020" BorderBrush="#D08E44" BorderThickness="1.3">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="14" />
                  <RowDefinition Height="22" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ACCESS LEVEL IV" FontSize="9" Foreground="#B79A6E" />
                <TextBlock Grid.Row="1" Text="GRAND VAULT" FontSize="13" FontWeight="Bold" Foreground="#FFE3A2" />
                <Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxHeight="28">
                  <TextBlock x:Name="GrandJackpotText" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                </Viewbox>
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="205" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,6,18,6">
              <Border Background="{StaticResource VaultGlassPanel}" BorderBrush="#437AAB" BorderThickness="1.6" CornerRadius="15" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="SYSTEM STATUS" FontSize="9" Foreground="#747D9D" />
                  <TextBlock x:Name="SystemStatusText" Text="VAULT ONLINE" FontSize="16" FontWeight="Bold" Foreground="#62E9FF" Margin="0,5,0,0" />
                  <TextBlock x:Name="AnticipationText" Text="1,024 WAYS ACTIVE" TextWrapping="Wrap" FontSize="11" Foreground="#A7AECB" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Background="{StaticResource VaultGlassPanel}" BorderBrush="#705AB3" BorderThickness="1.6" CornerRadius="15" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="FEATURE MATRIX" FontSize="9" Foreground="#747D9D" />
                  <TextBlock Text="WILD EXPANSION" Foreground="#68E9FF" FontSize="11" Margin="0,8,0,0" />
                  <TextBlock Text="BLACKOUT / OVERLOAD" Foreground="#FF718D" FontSize="11" Margin="0,5,0,0" />
                  <TextBlock Text="VAULT BREAK FREE SPINS" Foreground="#FFD66E" FontSize="11" Margin="0,5,0,0" />
                  <TextBlock Text="JACKPOT ACCESS KEYS" Foreground="#BDA9FF" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border x:Name="HighRollPanel" Background="{StaticResource VaultGlassPanel}" BorderBrush="#705AB3" BorderThickness="1.6" CornerRadius="15" Padding="16">
                <StackPanel>
                  <TextBlock Text="BET CLASS" FontSize="9" Foreground="#747D9D" />
                  <TextBlock x:Name="HighRollText" Text="STANDARD ACCESS" FontSize="14" FontWeight="Bold" Foreground="#C4CBE2" Margin="0,5,0,0" />
                  <TextBlock Text="High Roller presentation begins at $10K. Vault Class begins at $100K." TextWrapping="Wrap" FontSize="10" Foreground="#747D9D" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border x:Name="ReelFrame"
                    Grid.Column="1"
                    Margin="0,4"
                    Background="{StaticResource VaultReelBed}"
                    BorderBrush="{StaticResource VaultChrome}"
                    BorderThickness="3"
                    CornerRadius="22"
                    Padding="10">
              <Grid ClipToBounds="True">
                <Rectangle RadiusX="15" RadiusY="15" IsHitTestVisible="False">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#241E355D" Offset="0" />
                      <GradientStop Color="#050711" Offset="0.46" />
                      <GradientStop Color="#171044" Offset="1" />
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <Border Margin="4" BorderBrush="#4763ECFF" BorderThickness="1" CornerRadius="16"
                        Background="#14000000" IsHitTestVisible="False" />
                <Border Width="3" HorizontalAlignment="Left" Margin="5,25,0,25" CornerRadius="2"
                        Background="{StaticResource VaultChrome}" Opacity="0.65" IsHitTestVisible="False"/>
                <Border Width="3" HorizontalAlignment="Right" Margin="0,25,5,25" CornerRadius="2"
                        Background="{StaticResource VaultChrome}" Opacity="0.65" IsHitTestVisible="False"/>
                <Grid x:Name="ReelsHost" Margin="9" />
                <Border IsHitTestVisible="False" BorderBrush="#4DABF5FF" BorderThickness="1.3" CornerRadius="16" Margin="3" />
                <Rectangle IsHitTestVisible="False" Height="2" Fill="#8B58F3FF"
                           VerticalAlignment="Center" Margin="9,0" />
                <Rectangle x:Name="ReelScanBeam" Height="3" VerticalAlignment="Top"
                           IsHitTestVisible="False" Opacity="0.36" Margin="9,0">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#004DEBFF" Offset="0"/>
                      <GradientStop Color="#D57FFCFF" Offset="0.28"/>
                      <GradientStop Color="#FF68EEFF" Offset="0.54"/>
                      <GradientStop Color="#AFA767FF" Offset="0.8"/>
                      <GradientStop Color="#0069EFFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                  <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ReelScanBeamTransform"/>
                  </Rectangle.RenderTransform>
                </Rectangle>
              </Grid>
            </Border>

            <StackPanel Grid.Column="2" Margin="18,6,0,6">
              <Border Background="{StaticResource VaultGlassPanel}" BorderBrush="#4C82AD" BorderThickness="1.6" CornerRadius="15" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="VAULT ENERGY" FontSize="9" Foreground="#747D9D" />
                  <ProgressBar x:Name="EnergyBar" Minimum="0" Maximum="12" Height="13" Margin="0,12,0,8" Style="{StaticResource VaultEnergyBar}"/>
                  <TextBlock x:Name="EnergyText" Text="0 / 12" FontSize="11" Foreground="#C9CFE5" HorizontalAlignment="Right" />
                  <TextBlock Text="Fill during Free Spins to arm SECURITY OVERRIDE." FontSize="10" TextWrapping="Wrap" Foreground="#747D9D" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Background="{StaticResource VaultGlassPanel}" BorderBrush="#4C82AD" BorderThickness="1.6" CornerRadius="15" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="VAULT BREAK" FontSize="9" Foreground="#747D9D" />
                  <TextBlock x:Name="FreeSpinsText" Text="NO FREE SPINS" FontSize="16" FontWeight="Bold" Foreground="#FFD66E" Margin="0,5,0,0" />
                  <TextBlock Text="Wilds on reels 2–4 expand automatically during the bonus." FontSize="10" TextWrapping="Wrap" Foreground="#747D9D" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
              <Border Background="{StaticResource VaultGlassPanel}" BorderBrush="#4C82AD" BorderThickness="1.6" CornerRadius="15" Padding="16">
                <StackPanel>
                  <TextBlock Text="LAST RETURN" FontSize="9" Foreground="#747D9D" />
                  <TextBlock x:Name="LastWinText" Text="$0.00" FontSize="23" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,5,0,0" />
                  <TextBlock x:Name="LastFeatureText" Text="Ready for access." FontSize="10" TextWrapping="Wrap" Foreground="#8F98B7" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" Margin="0,15,0,0" Background="{StaticResource VaultGlassPanel}" BorderBrush="{StaticResource VaultChrome}" BorderThickness="2" CornerRadius="17" Padding="18,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="BET" FontSize="9" Foreground="#747D9D" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button x:Name="BetDownButton" Content="−" Style="{StaticResource VaultButton}" Width="42" Height="38" Padding="0" Click="BetDown_Click" />
                  <Border Background="{StaticResource VaultReelBed}" BorderBrush="#4CB8F2" BorderThickness="1.4" CornerRadius="9" Width="158" Height="41" Margin="6,0">
                    <TextBlock x:Name="BetText" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#F7F8FF" />
                  </Border>
                  <Button x:Name="BetUpButton" Content="+" Style="{StaticResource VaultButton}" Width="42" Height="38" Padding="0" Click="BetUp_Click" />
                  <Button x:Name="MaxBetButton" Content="MAX" Style="{StaticResource VaultButton}" Width="58" Height="38" Padding="0" Margin="6,0,0,0" Click="MaxBet_Click" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="1,024 WAYS  ·  FIVE REELS  ·  FOUR ROWS" FontSize="9" Foreground="#747D9D" />
                <TextBlock x:Name="ResultText" Text="System armed. Choose your exposure." FontSize="13" Foreground="#D3D8EB" Margin="0,8,0,0" />
                <TextBlock x:Name="RewardText" Text="Expanding Wilds · Blackout · Free Spins · Vault Jackpots" FontSize="10" Foreground="#7E87A8" Margin="0,5,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0">
                <CheckBox x:Name="SoundToggle" Content="SFX" Style="{StaticResource VaultToggle}" Checked="Settings_Changed" Unchecked="Settings_Changed" />
                <CheckBox x:Name="AnimationToggle" Content="ANIMATIONS" Style="{StaticResource VaultToggle}" Checked="Settings_Changed" Unchecked="Settings_Changed" />
              </StackPanel>

              <Button x:Name="SpinButton" Grid.Column="3" Content="SPIN  [SPACE]" Style="{StaticResource SpinButtonStyle}" Click="Spin_Click" />
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="FeatureOverlay" Visibility="Collapsed" Background="#E0000008" Panel.ZIndex="90" IsHitTestVisible="False">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="FeatureKicker" Text="SYSTEM EVENT" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#8F97B7" />
            <TextBlock x:Name="FeatureTitle" Text="BLACKOUT" HorizontalAlignment="Center" FontSize="58" FontWeight="Bold" Foreground="#FF5B79" Margin="0,10,0,0" />
            <TextBlock x:Name="FeatureSubtitle" Text="SECURITY GRID OFFLINE" HorizontalAlignment="Center" FontSize="14" Foreground="#E4E8F8" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>

        <Border x:Name="BigWinPanel"
                Visibility="Collapsed"
                Background="{StaticResource VaultGlassPanel}"
                BorderBrush="{StaticResource VaultChrome}"
                BorderThickness="3"
                CornerRadius="22"
                Padding="34,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="95"
                IsHitTestVisible="False">
          <StackPanel>
            <TextBlock x:Name="BigWinTitle" Text="BIG WIN" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Foreground="#FFE6A8" />
            <TextBlock x:Name="BigWinAmount" Text="$0.00" HorizontalAlignment="Center" FontSize="48" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</Window>
