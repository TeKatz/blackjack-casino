<Window x:Class="BlackjackCasino.Desktop.SlotMachineWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Midnight Reels · Blackjack Casino" Width="1100" Height="800" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#100D18" Foreground="#F7EEDB" FontFamily="Segoe UI"
        PreviewKeyDown="Window_KeyDown" Closed="Window_Closed">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Presentation/SlotTextures.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style x:Key="SlotButton" TargetType="Button">
        <Setter Property="Foreground" Value="#F7EEDB"/><Setter Property="Background" Value="#302539"/><Setter Property="BorderBrush" Value="#66516D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F3CD7A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C6B7CE"/><Setter Property="Margin" Value="6,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel><TextBlock Text="CASINO / SLOTS" Foreground="#B39CBE" FontSize="11"/><TextBlock Text="MIDNIGHT REELS" FontSize="23" FontWeight="Bold"/></StackPanel>
      <Button Content="← Back to Blackjack  [Esc]" Style="{StaticResource SlotButton}" HorizontalAlignment="Right" Click="Back_Click"/>
    </Grid>
    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,12,0,0">
      <Grid Width="1000" Height="650">
        <Grid.ColumnDefinitions><ColumnDefinition Width="674"/><ColumnDefinition Width="20"/><ColumnDefinition Width="306"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SlotCabinet}" BorderBrush="{StaticResource SlotGold}" BorderThickness="3" CornerRadius="26" Padding="20">
          <Grid>
            <Border Background="{StaticResource SlotGrain}" CornerRadius="14" IsHitTestVisible="False"/>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="75"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="✦  M I D N I G H T  ✦" FontSize="27" FontWeight="Bold" Foreground="#F9D890"/><TextBlock Text="THREE REELS · ONE PAYLINE · PLAY MONEY" FontSize="10" Foreground="#B7A2BE" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
              <Border x:Name="ReelFrame" Grid.Row="1" Background="#08070E" BorderBrush="{StaticResource SlotGold}" BorderThickness="3" CornerRadius="14" Padding="11,13">
                <Grid>
                  <StackPanel x:Name="ReelsHost" Orientation="Horizontal" HorizontalAlignment="Center"/>
                  <Border IsHitTestVisible="False" Height="92" VerticalAlignment="Center" BorderBrush="#D3B167" BorderThickness="0,1" Background="#09E4C385"/>
                  <TextBlock Text="▸" Foreground="#F3CD7A" FontSize="23" VerticalAlignment="Center" Margin="-14,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                  <TextBlock Text="◂" Foreground="#F3CD7A" FontSize="23" VerticalAlignment="Center" Margin="0,0,-14,0" HorizontalAlignment="Right" IsHitTestVisible="False"/>
                  <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C9151020" Offset="0"/><GradientStop Color="#00151020" Offset="0.35"/><GradientStop Color="#00151020" Offset="0.65"/><GradientStop Color="#C9151020" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                </Grid>
              </Border>
              <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock x:Name="ResultText" Text="Your next little escape." TextAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#FFE1A3"/><TextBlock x:Name="RewardText" Text="Choose a bet, then spin. Space also works." TextAlignment="Center" Foreground="#B9A7C4" Margin="0,5,0,0" FontSize="12"/></StackPanel>
              <Grid Grid.Row="3">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SHARED BANKROLL" Foreground="#B9A7C4" FontSize="10"/><TextBlock x:Name="BalanceText" FontSize="27" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="BET PER SPIN" Foreground="#B9A7C4" FontSize="10" HorizontalAlignment="Right"/><TextBlock x:Name="BetText" FontSize="27" FontWeight="Bold" Foreground="#F5D18B" HorizontalAlignment="Right"/></StackPanel></Grid>
                <StackPanel x:Name="BetControls" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,5"><Button Content="$1" Tag="1" Style="{StaticResource SlotButton}" Click="Bet_Click"/><Button Content="$5" Tag="5" Style="{StaticResource SlotButton}" Click="Bet_Click"/><Button Content="$25" Tag="25" Style="{StaticResource SlotButton}" Click="Bet_Click"/><Button Content="$100" Tag="100" Style="{StaticResource SlotButton}" Click="Bet_Click"/><Button Content="$500" Tag="500" Style="{StaticResource SlotButton}" Click="Bet_Click"/><Button Content="$1,000" Tag="1000" Style="{StaticResource SlotButton}" Click="Bet_Click"/></StackPanel>
                <Button x:Name="SpinButton" Grid.Row="2" Content="SPIN  [SPACE]" Style="{StaticResource SlotButton}" Click="Spin_Click" FontSize="19" Foreground="#20101F" Background="{StaticResource SlotGold}" BorderBrush="#F3DA9F" Margin="4,5,4,0"/>
              </Grid>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="#1B1524" BorderBrush="#49364F" BorderThickness="1" CornerRadius="18" Padding="20">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="THE PAYTABLE" FontSize="17" FontWeight="Bold" Foreground="#F5D18B"/><TextBlock Text="Three matching symbols on the centre line" Foreground="#B9A7C4" TextWrapping="Wrap" Margin="0,7,0,12"/></StackPanel>
            <StackPanel x:Name="PaytableHost" Grid.Row="1"/>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="Any two cherries return 1× your bet." Foreground="#E3D4E8" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Payouts include the stake. Only the centre line pays; all other combinations return $0." Foreground="#AA97B6" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="Independent weighted reels · theoretical return 97.05%." Foreground="#AA97B6" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
            <StackPanel Grid.Row="3" VerticalAlignment="Center"><TextBlock x:Name="ProfileText" Foreground="#F5D18B" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock x:Name="StatsText" Foreground="#B9A7C4" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="Every spin: 20 XP + 15 Season XP.&#10;Profit: +5 XP and +5 Season XP.&#10;Bet size never changes XP." Foreground="#B9A7C4" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
            <StackPanel Grid.Row="4"><CheckBox x:Name="SoundToggle" Content="Slot sounds" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="AnimationToggle" Content="Reel &amp; light animations" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Free, offline play money only." FontSize="11" Foreground="#927F9E" Margin="6,8,0,0"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</Window>
