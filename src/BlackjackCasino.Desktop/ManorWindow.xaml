<Window x:Class="BlackjackCasino.Desktop.ManorWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BlackjackCasino.Desktop" Title="Midnight Manor · Blackjack Casino"
 Width="1280" Height="890" MinWidth="1000" MinHeight="760" Background="#101019" Foreground="#E9E2D4" FontFamily="Segoe UI"
 WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_KeyDown" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
 <Window.Resources>
  <LinearGradientBrush x:Key="Brass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6A5037" Offset="0"/><GradientStop Color="#D6BD88" Offset="0.4"/><GradientStop Color="#937349" Offset="0.7"/><GradientStop Color="#C3A374" Offset="1"/></LinearGradientBrush>
  <Style x:Key="ManorButton" TargetType="Button">
   <Setter Property="Background" Value="#2D2430"/><Setter Property="Foreground" Value="#E9E0CF"/><Setter Property="BorderBrush" Value="#6B5860"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E8CF99"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#EDF0E5"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.36"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CEC1CE"/><Setter Property="Margin" Value="4,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#19151F"/><Setter Property="Foreground" Value="#ECE3D5"/><Setter Property="BorderBrush" Value="#68545F"/><Setter Property="Padding" Value="8,6"/></Style>
 </Window.Resources>
 <Viewbox Stretch="Uniform" Margin="16">
  <Grid Width="1180" Height="760">
   <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="622"/><RowDefinition Height="72"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="BLACKJACK CASINO  /  A DIFFERENT KIND OF NIGHT" FontSize="10" Foreground="#9E91A9"/><TextBlock Text="MIDNIGHT MANOR" FontSize="29" FontFamily="Georgia" FontWeight="Bold" Foreground="#D9BE88"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><StackPanel Margin="0,0,20,0"><TextBlock Text="SHARED PLAY-MONEY BANKROLL" Foreground="#A798B3" FontSize="10" HorizontalAlignment="Right"/><TextBlock x:Name="BalanceText" FontSize="23" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel><Button Content="← Blackjack  [Esc]" Style="{StaticResource ManorButton}" Click="Back_Click" VerticalAlignment="Top"/></StackPanel></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="858"/><ColumnDefinition Width="18"/><ColumnDefinition Width="304"/></Grid.ColumnDefinitions>
    <Border BorderBrush="{StaticResource Brass}" BorderThickness="3" CornerRadius="15" Background="#231B23" Padding="14">
     <Grid>
      <local:ManorBackdrop x:Name="MachineScene" Scene="Exterior" Opacity="0.44" IsHitTestVisible="False"/>
      <Grid Margin="12,4"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="288"/><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel HorizontalAlignment="Center"><TextBlock Text="THE HOUSE REMEMBERS" FontFamily="Georgia" FontSize="19" Foreground="#E8D1A0" HorizontalAlignment="Center"/><TextBlock x:Name="ModeText" Text="20 FIXED PAYLINES · FIVE REELS · ONE HAUNTED NIGHT" FontSize="10" Foreground="#BEAFC5" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
       <Border x:Name="ReelFrame" Grid.Row="1" Background="#17141D" BorderBrush="{StaticResource Brass}" BorderThickness="2" Padding="10,0" CornerRadius="8"><Grid><Grid x:Name="ReelsHost" Width="760" Height="282" HorizontalAlignment="Center" VerticalAlignment="Center"/><Canvas x:Name="PaylineCanvas" IsHitTestVisible="False" Width="760" Height="282" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/></Grid></Border>
       <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock x:Name="WinText" Text="A quiet invitation." TextAlignment="Center" FontSize="23" FontFamily="Georgia" Foreground="#F0D9A5"/><TextBlock x:Name="SpinNote" Text="Three Moons: Free Spins. Three Doors: enter the Manor." TextAlignment="Center" Foreground="#C1AEC9" FontSize="12" Margin="0,5,0,0"/></StackPanel>
       <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="TOTAL BET" FontSize="10" Foreground="#B9A7C1" VerticalAlignment="Center"/><TextBlock x:Name="BetText" Foreground="#E8D1A0" FontSize="24" FontWeight="Bold" Margin="12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="SPEED" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center"/><ComboBox x:Name="SpeedBox" Width="135" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Fast"/><ComboBoxItem Content="Turbo"/></ComboBox></StackPanel></Grid>
        <UniformGrid x:Name="BetControls" Grid.Row="1" Columns="6" Margin="0,5,0,4"><Button Content="$1" Tag="1" Style="{StaticResource ManorButton}" Click="Bet_Click"/><Button Content="$5" Tag="5" Style="{StaticResource ManorButton}" Click="Bet_Click"/><Button Content="$25" Tag="25" Style="{StaticResource ManorButton}" Click="Bet_Click"/><Button Content="$100" Tag="100" Style="{StaticResource ManorButton}" Click="Bet_Click"/><Button Content="$500" Tag="500" Style="{StaticResource ManorButton}" Click="Bet_Click"/><Button Content="$1,000" Tag="1000" Style="{StaticResource ManorButton}" Click="Bet_Click"/></UniformGrid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Button x:Name="SpinButton" Content="SPIN  [SPACE]" Style="{StaticResource ManorButton}" FontSize="19" Background="{StaticResource Brass}" Foreground="#21151D" Click="Spin_Click"/><ComboBox x:Name="AutoBox" Grid.Column="1" Margin="4" VerticalAlignment="Center" SelectionChanged="Settings_Changed"><ComboBoxItem Content="Off"/><ComboBoxItem Content="10"/><ComboBoxItem Content="25"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="Unlimited"/></ComboBox><Button x:Name="AutoButton" Grid.Column="2" Content="START AUTO" Style="{StaticResource ManorButton}" Click="Auto_Click"/><Button x:Name="StopButton" Grid.Column="3" Content="STOP" Style="{StaticResource ManorButton}" Click="Stop_Click" BorderBrush="#AA6579"/></Grid>
       </Grid>
      </Grid>
     </Grid>
    </Border>
    <Border Grid.Column="2" Background="#1B1722" BorderBrush="#53414E" BorderThickness="1" CornerRadius="12" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <UniformGrid Columns="3"><Button Content="Payouts" Tag="Paytable" Style="{StaticResource ManorButton}" Click="Tab_Click" Padding="5,8"/><Button Content="Settings" Tag="Settings" Style="{StaticResource ManorButton}" Click="Tab_Click" Padding="5,8"/><Button Content="Stats" Tag="Stats" Style="{StaticResource ManorButton}" Click="Tab_Click" Padding="5,8"/></UniformGrid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="3,10,3,0"><Grid>
      <StackPanel x:Name="PaytablePanel"><TextBlock Text="3 / 4 / 5 MATCHES FROM THE LEFT" Foreground="#D9BE88" FontWeight="Bold" FontSize="11"/><TextBlock Text="Line credits × total bet ÷ 20" Foreground="#A798B3" FontSize="11" Margin="0,4,0,7"/><StackPanel x:Name="PaytableRows"/><TextBlock Text="Wild substitutes regular symbols. Highest award once per line. Payouts include stake.&#10;&#10;3 / 4 / 5 Moons: 8 / 12 / 20 Free Spins with 2× line wins. Features do not retrigger during Free Spins.&#10;&#10;3 / 4 / 5 Doors: Manor Exit target 250× / 500× / 1000×.&#10;&#10;Reference-policy RTP 95.4539%. Manual choices can change risk and return." TextWrapping="Wrap" FontSize="11" Foreground="#BBAAC6" Margin="0,10,0,0"/></StackPanel>
      <StackPanel x:Name="SettingsPanel" Visibility="Collapsed"><TextBlock Text="YOUR NIGHT, YOUR PACE" FontWeight="Bold" Foreground="#D9BE88"/><CheckBox x:Name="InteractiveBox" Content="Play Escape the Manor interactively" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Auto uses the same map and ghost rules, following the recommendation. No skip fee or payout reduction. Manual routes change real risk and return." TextWrapping="Wrap" Foreground="#AA99B8" FontSize="11" Margin="4,0,4,10"/><CheckBox x:Name="StopBigBox" Content="Stop Auto on Big Win (25×+)" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="StopBonusBox" Content="Stop Auto after Manor Bonus" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Auto bankroll floor ($)" Margin="4,10,4,5"/><TextBox x:Name="FloorBox" Text="0" LostFocus="Settings_Changed"/><CheckBox x:Name="SoundBox" Content="Sound effects" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="MusicBox" Content="Manor ambience / music" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="AnimationBox" Content="Animations" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Audio uses the casino's saved music volume. Closing saves any open feature for your next visit. Auto never starts itself after reopening." TextWrapping="Wrap" Foreground="#AA99B8" FontSize="11" Margin="4,12,4,0"/></StackPanel>
      <StackPanel x:Name="StatsPanel" Visibility="Collapsed"><TextBlock Text="MIDNIGHT MANOR RECORD" FontWeight="Bold" Foreground="#D9BE88"/><TextBlock x:Name="StatsText" TextWrapping="Wrap" Foreground="#C8BACF" FontSize="13" LineHeight="25" Margin="4,15,4,0"/></StackPanel>
     </Grid></ScrollViewer>
    </Grid></Border>
    <Grid x:Name="BonusPanel" Visibility="Collapsed" Background="#15121D">
     <local:ManorBackdrop x:Name="RoomScene" Scene="Entrance" IsHitTestVisible="False"/>
     <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="65"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Border Background="#CC17131D" BorderBrush="#786047" BorderThickness="1" CornerRadius="8" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ESCAPE THE MANOR" FontFamily="Georgia" FontSize="19" Foreground="#DAC28C"/><TextBlock x:Name="RoomText" FontSize="13" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="CURRENT / CHECKPOINT" FontSize="10" Foreground="#AB99B6"/><TextBlock x:Name="RewardText" FontSize="22" FontWeight="Bold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="HAUNT / 8" FontSize="10" Foreground="#AB99B6"/><TextBlock x:Name="HauntText" Foreground="#D28FA4" FontSize="23" FontWeight="Bold"/></StackPanel></Grid></Border>
      <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="6,0,6,10" Background="#AA13121C"><TextBlock x:Name="GhostText" TextWrapping="Wrap" Foreground="#E1C9DA" FontSize="13" Margin="10,6"/><TextBlock x:Name="RoomNote" TextWrapping="Wrap" Foreground="#C2B7CC" FontSize="12" Margin="10,0,10,8"/></StackPanel>
      <Border Grid.Row="2" Background="#E6191723" CornerRadius="8" BorderBrush="#635064" BorderThickness="1"><Canvas x:Name="MapCanvas" Width="790" Height="165" ClipToBounds="True"/></Border>
      <WrapPanel x:Name="RoutesPanel" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="RecommendButton" Content="FOLLOW RECOMMENDATION  [R]" Style="{StaticResource ManorButton}" Click="Recommend_Click" FontSize="11"/><Button x:Name="CandleButton" Grid.Column="1" Content="CANDLE  [C]" Style="{StaticResource ManorButton}" Click="Candle_Click"/><Button x:Name="LeaveButton" Grid.Column="2" Content="LEAVE MANOR  [L]" Style="{StaticResource ManorButton}" Click="Leave_Click" Background="{StaticResource Brass}" Foreground="#221622" FontSize="12"/></Grid>
     </Grid>
    </Grid>
    <Grid x:Name="DoorPanel" Visibility="Collapsed" Background="#11121B"><local:ManorBackdrop x:Name="DoorScene" Scene="Door"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Background="#A011121B" Margin="0,280,0,0"><TextBlock x:Name="DoorTitle" Text="ESCAPE THE MANOR" FontFamily="Georgia" FontSize="35" Foreground="#EBD2A1" Margin="25,15"/><TextBlock x:Name="DoorNote" TextAlignment="Center" Foreground="#CBB9D4" Margin="12,0,12,15"/></StackPanel></Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="4,12,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Play money only · settings and pending features save automatically." TextWrapping="Wrap" FontSize="12" Foreground="#B5A5C0"/><TextBlock x:Name="ProfileText" Foreground="#D4BD8B" FontSize="12" Margin="0,8,0,0"/></StackPanel><TextBlock x:Name="AutoText" Grid.Column="1" Foreground="#D8B3CA" FontSize="13" VerticalAlignment="Top"/></Grid>
  </Grid>
 </Viewbox>
</Window>
