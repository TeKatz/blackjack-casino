<Application x:Class="BlackjackCasino.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style x:Key="CasinoScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="#426853" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#315744"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="2" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbChrome" Property="Background" Value="#5B7D68" />
                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#718D78" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbChrome" Property="Background" Value="#9A8248" />
                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#C6A95D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#091C13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Border Background="#0D2418" BorderBrush="#1F3D2E" BorderThickness="1" CornerRadius="8" Margin="2" />
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     IsDirectionReversed="True"
                     Focusable="False"
                     Margin="1">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb" Style="{StaticResource CasinoScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Vertical">
                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="72" />
                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="0" />
              </Trigger>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="72" />
                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="16" />
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="16" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#EEF3EF" />
      <Setter Property="Background" Value="#0D281B" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#173A29" />
                <Setter Property="Foreground" Value="#F8F5EC" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#1A3F2C" />
                <Setter Property="Foreground" Value="#F2CF7A" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EEF3EF" />
      <Setter Property="Background" Value="#102C1F" />
      <Setter Property="BorderBrush" Value="#385A46" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Grid>
                  <ContentPresenter Margin="10,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="#EEF3EF" />
                  <Path Width="8" Height="5" Margin="0,0,11,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#D5B15E" Data="M 0 0 L 4 5 L 8 0 Z" />
                </Grid>
              </Border>
              <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" Background="#0A2015" BorderBrush="#385A46" BorderThickness="1" CornerRadius="7">
                  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.38" /></Border.Effect>
                  <ScrollViewer Margin="4" MaxHeight="260" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#52715E" /></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#A78848" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboChrome" Property="Opacity" Value="0.58" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
