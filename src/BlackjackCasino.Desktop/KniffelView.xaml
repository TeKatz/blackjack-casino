<UserControl x:Class="BlackjackCasino.Desktop.KniffelView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0B1919" Focusable="True" UseLayoutRounding="True">
 <UserControl.Resources>
  <Style x:Key="PaperButton" TargetType="Button">
   <Setter Property="OverridesDefaultStyle" Value="True"/>
   <Setter Property="Foreground" Value="#263F3B"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="#D8CEB9"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="10,4"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="RowChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="#CBE5D7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowChrome" Property="BorderBrush" Value="#127A68"/><Setter TargetName="RowChrome" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Viewbox Stretch="Uniform" Margin="16">
  <Grid Width="1160" Height="748">
   <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="650"/><ColumnDefinition Width="24"/><ColumnDefinition Width="486"/></Grid.ColumnDefinitions>
   <StackPanel Grid.ColumnSpan="2" Margin="6,2,0,0">
    <TextBlock Text="THE MIDNIGHT CLUB  /  DICE LOUNGE" Foreground="#CDB17A" FontSize="11" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
     <TextBlock Text="Midnight Dice" FontFamily="Georgia" FontSize="36" Foreground="#F5EAD3"/>
     <Border Background="#203F36" CornerRadius="10" Padding="12,5" Margin="18,12,0,5"><TextBlock x:Name="ModeLabel" Text="CASUAL · SOLO" Foreground="#AEDBC5" FontSize="10"/></Border>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="NewGameButton" Content="New game" Padding="16,9" Margin="0,0,9,0" Click="NewGame_Click"/>
    <Button x:Name="KniffelBackButton" Content="← Casino" Padding="16,9" Click="Back_Click"/>
   </StackPanel>
   <Border Grid.Row="1" BorderBrush="#526449" BorderThickness="2" CornerRadius="24" Padding="24">
    <Border.Background><RadialGradientBrush GradientOrigin="0.5,0.35"><GradientStop Color="#244B3E" Offset="0"/><GradientStop Color="#102922" Offset="1"/></RadialGradientBrush></Border.Background>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="80"/><RowDefinition Height="172"/><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <StackPanel><TextBlock Text="YOUR DICE TABLE" Foreground="#BECCA9" FontSize="11"/><TextBlock x:Name="TurnText" Foreground="#F3E6CF" FontSize="28" FontFamily="Georgia" Margin="0,8,0,0"/></StackPanel>
      <StackPanel HorizontalAlignment="Right"><TextBlock Text="TOTAL SCORE" Foreground="#BECCA9" FontSize="11"/><TextBlock x:Name="TotalText" Foreground="#F0D395" FontSize="34" HorizontalAlignment="Right" FontWeight="Bold"/></StackPanel>
     </Grid>
     <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock x:Name="RollText" Foreground="#E8D9B6" FontSize="15" HorizontalAlignment="Center"/>
      <TextBlock Text="Click dice to hold or release" Foreground="#A6BEAC" FontSize="13" HorizontalAlignment="Center" Margin="0,9,0,0"/>
      <TextBlock x:Name="TableStandingsText" Visibility="Collapsed" Foreground="#F0D395" FontSize="12" HorizontalAlignment="Center" Margin="0,9,0,0"/>
     </StackPanel>
     <UniformGrid x:Name="DicePanel" Grid.Row="2" Columns="5" VerticalAlignment="Center"/>
     <StackPanel Grid.Row="3" VerticalAlignment="Center">
     <TextBlock x:Name="CombinationText" Foreground="#F4D798" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
     <Button x:Name="OpponentSheetsButton" Content="View opponents’ score sheets" Visibility="Collapsed" Padding="8,3" FontSize="10" HorizontalAlignment="Center" Click="OpponentSheets_Click"/>
     </StackPanel>
     <StackPanel Grid.Row="4" VerticalAlignment="Center">
      <Button x:Name="RollButton" Content="Roll dice" FontSize="18" FontWeight="SemiBold" Padding="28,14" HorizontalAlignment="Center" MinWidth="250" Click="Roll_Click"/>
      <TextBlock x:Name="TableRulesText" Text="Up to 3 rolls · 13 turns · no wager" Foreground="#9BB4A3" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0"/>
      <TextBlock Text="Glowing boxes show your possible scores.&#10;Choose a box on the sheet and confirm your score." Foreground="#B2C6B6" FontSize="13" TextAlignment="Center" Margin="0,10,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Row="1" Grid.Column="2" CornerRadius="9" Background="#EFE7D6" BorderBrush="#B6A88B" BorderThickness="1" Padding="22,16">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.35"/></Border.Effect>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="68"/><RowDefinition Height="54"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="Your score sheet" FontFamily="Georgia" FontSize="24" Foreground="#263F3B"/><TextBlock Text="POINTS" Foreground="#79705D" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,5"/></Grid>
     <StackPanel x:Name="ScoreRows" Grid.Row="1"/>
     <StackPanel Grid.Row="2" Margin="0,7,0,0">
      <TextBlock x:Name="UpperText" FontSize="12" Foreground="#526155"/>
      <TextBlock x:Name="BonusText" FontSize="12" Foreground="#526155" Margin="0,4,0,0"/>
      <TextBlock x:Name="AdditionalText" FontSize="12" Foreground="#526155" Margin="0,4,0,0"/>
     </StackPanel>
     <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <Button x:Name="CommitButton" Content="Record score" Padding="10,8" Click="Commit_Click"/>
      <Button x:Name="ScratchButton" Grid.Column="2" Content="Scratch" Padding="8" ToolTip="Fill this box with zero points" Click="Scratch_Click"/>
     </Grid>
    </Grid>
   </Border>
   <TextBlock x:Name="NoticeText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="#B9CCBD" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,8,6,0"/>
   <Border x:Name="RestartOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#E6101D1A" CornerRadius="14" Visibility="Collapsed">
    <Border Background="#1D352C" BorderBrush="#C5AD78" BorderThickness="1" CornerRadius="14" Padding="32" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
     <StackPanel><TextBlock Text="Start a new game?" Foreground="#F4E6CC" FontFamily="Georgia" FontSize="26"/><TextBlock Text="This replaces your current game. You can return to the casino at any time and resume later." Foreground="#B9CCBD" FontSize="15" TextWrapping="Wrap" Margin="0,18,0,22"/>
      <Button x:Name="ConfirmRestartButton" Content="Start new game" Padding="18,12" Click="ConfirmRestart_Click"/>
      <Button x:Name="CancelRestartButton" Content="Continue game" Padding="18,12" Margin="0,10,0,0" Click="CancelRestart_Click"/>
     </StackPanel>
    </Border>
   </Border>
  </Grid>
 </Viewbox>
</UserControl>
