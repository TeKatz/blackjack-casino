                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="38" Height="34"
                                        Style="{StaticResource ChromeButton}" Padding="0" Content="×" Click="ClosePaytable_Click"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,24,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="BASE GAME" Foreground="#C46DF0" FontFamily="Segoe UI Semibold" FontSize="13"/>
                                    <TextBlock Text="Three horizontal rows plus both diagonals pay left-to-right across the full 3×3 grid. Wild substitutes for regular symbols."
                                               Foreground="#D8CCD9" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,22"/>
                                    <TextBlock Text="POUNCE WILD" Foreground="#F1C965" FontFamily="Segoe UI Semibold" FontSize="13"/>
                                    <TextBlock Text="A landed Wild can pounce to a second cell after the reels settle, creating a last-second line opportunity."
                                               Foreground="#D8CCD9" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="NINE LIVES BONUS" Foreground="#C46DF0" FontFamily="Segoe UI Semibold" FontSize="13"/>
                                    <TextBlock Text="Three Nine Lives symbols award nine bonus spins. Bonus spins use the triggering bet and cost no additional bankroll."
