<Window x:Class="BlackjackCasino.Desktop.NineLivesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nine Lives"
        Width="1536" Height="1024"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#090711"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="HotspotButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HudPanel" TargetType="Border">
            <Setter Property="Background" Value="#E90B0912"/>
            <Setter Property="BorderBrush" Value="#D59B4B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="HudText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD57A"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
    </Window.Resources>

    <Grid Background="#090711">
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="1536" Height="1024" ClipToBounds="True">
                <Image x:Name="BackgroundArt" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Background="#12000000" IsHitTestVisible="False"/>

                <!-- Dynamic HUD covers the baked concept values while preserving the composition. -->
                <Canvas Panel.ZIndex="20">
                    <Button x:Name="CasinoButton" Style="{StaticResource HotspotButton}" Canvas.Left="18" Canvas.Top="7" Width="170" Height="48" Click="CasinoButton_Click" ToolTip="Back to Casino"/>

                    <Border Style="{StaticResource HudPanel}" Canvas.Left="1153" Canvas.Top="8" Width="146" Height="45">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="#F0B34F" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock x:Name="BankrollText" Style="{StaticResource HudText}" FontSize="19" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HudPanel}" Canvas.Left="1306" Canvas.Top="8" Width="145" Height="45">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="★" Foreground="#D75CFF" FontSize="20" Margin="0,0,10,0"/>
                            <TextBlock x:Name="LevelText" Style="{StaticResource HudText}" FontSize="18" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Style="{StaticResource HotspotButton}" Canvas.Left="1458" Canvas.Top="6" Width="62" Height="49" Click="SettingsButton_Click" ToolTip="Sound / animation settings"/>

                    <!-- Real 3x3 reels sit exactly over the concept-art reel cells. -->
                    <Canvas x:Name="ReelCanvas" Canvas.Left="0" Canvas.Top="0" Width="1536" Height="1024"/>
                    <Canvas x:Name="WinLineCanvas" Canvas.Left="0" Canvas.Top="0" Width="1536" Height="1024" IsHitTestVisible="False"/>

                    <Border x:Name="StatusBadge" Canvas.Left="510" Canvas.Top="805" Width="516" Height="43"
                            Background="#D80A0713" BorderBrush="#9347E9" BorderThickness="1" CornerRadius="18" Opacity="0.94">
                        <TextBlock x:Name="StatusText" Text="Five lines. Three reels. One dangerous cat."
                                   Foreground="#F8D8FF" FontFamily="Segoe UI Semibold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="BonusBadge" Canvas.Left="615" Canvas.Top="151" Width="305" Height="38"
                            Background="#D90B0715" BorderBrush="#F5C45D" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                        <TextBlock x:Name="BonusText" Style="{StaticResource HudText}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Bottom console: artwork stays visible; hotspots provide real controls. -->
                    <Border Canvas.Left="226" Canvas.Top="902" Width="158" Height="59" Background="#F20A0911" CornerRadius="8">
                        <TextBlock x:Name="BetText" Style="{StaticResource HudText}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="BetDownButton" Style="{StaticResource HotspotButton}" Canvas.Left="157" Canvas.Top="894" Width="78" Height="75" Click="BetDownButton_Click" ToolTip="Lower bet"/>
                    <Button x:Name="BetUpButton" Style="{StaticResource HotspotButton}" Canvas.Left="382" Canvas.Top="894" Width="78" Height="75" Click="BetUpButton_Click" ToolTip="Raise bet"/>
                    <Button x:Name="AutoButton" Style="{StaticResource HotspotButton}" Canvas.Left="488" Canvas.Top="881" Width="177" Height="75" Click="AutoButton_Click" ToolTip="Auto spin"/>
                    <Button x:Name="SpinButton" Style="{StaticResource HotspotButton}" Canvas.Left="665" Canvas.Top="833" Width="205" Height="181" Click="SpinButton_Click" ToolTip="Spin"/>
                    <Button x:Name="MaxButton" Style="{StaticResource HotspotButton}" Canvas.Left="878" Canvas.Top="882" Width="178" Height="75" Click="MaxButton_Click" ToolTip="Maximum affordable bet"/>
                    <Border Canvas.Left="1112" Canvas.Top="902" Width="229" Height="59" Background="#F20A0911" CornerRadius="8">
                        <TextBlock x:Name="WinText" Style="{StaticResource HudText}" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="InfoButton" Style="{StaticResource HotspotButton}" Canvas.Left="35" Canvas.Top="873" Width="90" Height="91" Click="InfoButton_Click" ToolTip="Paytable"/>
                    <Button x:Name="MenuButton" Style="{StaticResource HotspotButton}" Canvas.Left="1411" Canvas.Top="873" Width="92" Height="91" Click="CasinoButton_Click" ToolTip="Back to Casino"/>
                </Canvas>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
