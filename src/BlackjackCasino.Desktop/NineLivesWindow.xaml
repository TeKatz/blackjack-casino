<Window x:Class="BlackjackCasino.Desktop.NineLivesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlackjackCasino.Desktop"
        Title="Nine Lives"
        Width="1760" Height="960"
        MinWidth="1100" MinHeight="690"
        WindowStartupLocation="CenterOwner"
        Background="#08060E"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <!-- Resolution-independent machine art materials. -->
        <LinearGradientBrush x:Key="NineLivesGold" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6C4026" Offset="0"/>
            <GradientStop Color="#FFE9B8" Offset="0.16"/>
            <GradientStop Color="#946439" Offset="0.39"/>
            <GradientStop Color="#F6D48D" Offset="0.64"/>
            <GradientStop Color="#583821" Offset="0.86"/>
            <GradientStop Color="#D5A66B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NineLivesIris" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#704287" Offset="0"/>
            <GradientStop Color="#E7C486" Offset="0.28"/>
            <GradientStop Color="#664278" Offset="0.54"/>
            <GradientStop Color="#E4B87C" Offset="0.82"/>
            <GradientStop Color="#75408B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NineLivesEnamel" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F51B102F" Offset="0"/>
            <GradientStop Color="#F6090B16" Offset="0.48"/>
            <GradientStop Color="#F4160C25" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NineLivesGoldFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF2C2" Offset="0"/>
            <GradientStop Color="#F0CF7F" Offset="0.26"/>
            <GradientStop Color="#BD8844" Offset="0.78"/>
            <GradientStop Color="#754B26" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NineLivesVioletFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#64386E" Offset="0"/>
            <GradientStop Color="#2A1735" Offset="0.16"/>
            <GradientStop Color="#140E20" Offset="0.83"/>
            <GradientStop Color="#4B2C55" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8E9FF"/>
            <Setter Property="Background" Value="{StaticResource NineLivesVioletFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NineLivesIris}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <Grid>
                            <Border Margin="3" CornerRadius="9" BorderBrush="#55F2D7AA" BorderThickness="1" IsHitTestVisible="False"/>
                            <Border VerticalAlignment="Top" Height="1" Margin="14,5,14,0"
                                    Background="#80F5DEB0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#55305F"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFF0B4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Foreground" Value="#24131C"/>
            <Setter Property="Background" Value="{StaticResource NineLivesGoldFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NineLivesGold}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GoldShell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="13">
                            <Grid>
                                <Border Margin="4" BorderBrush="#99FFF1C5" BorderThickness="1" CornerRadius="9"
                                        IsHitTestVisible="False"/>
                                <Border VerticalAlignment="Top" Height="1.5" Background="#A0FFF8D8"
                                        Margin="15,6,15,0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GoldShell" Property="BorderBrush" Value="#FFFFD993"/>
                                <Setter TargetName="GoldShell" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GoldShell" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GoldShell" Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpinButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Foreground" Value="#FFF7D7"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="21" BorderBrush="{StaticResource NineLivesGold}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A3538A" Offset="0"/>
                                    <GradientStop Color="#47205A" Offset="0.52"/>
                                    <GradientStop Color="#1A0D2D" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Margin="5" BorderBrush="#72F2D3A3" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False"/>
                                <Path Data="M 0,0 L 26,0" Stroke="#A0FFE2B5" StrokeThickness="1.6"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,10,0,0" IsHitTestVisible="False"/>
                                <Path Data="M 0,0 L 26,0" Stroke="#A0FFE2B5" StrokeThickness="1.6"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,10" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFF1A6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HudPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NineLivesEnamel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NineLivesGold}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="CornerRadius" Value="11"/>
        </Style>
        <Style x:Key="HudText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD57A"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A893B4"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="SettingsToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#EEE5F3"/>
            <Setter Property="Background" Value="#17101F"/>
            <Setter Property="BorderBrush" Value="#493052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11"
                                        Background="#35263E" BorderBrush="#65506E" BorderThickness="1">
                                    <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#A993B3"
                                             HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#7B2FA8"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#D96CFF"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FFE08A"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#8F58A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#08060E">
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="NineLivesStage" Width="1760" Height="960" ClipToBounds="True">
                <Image x:Name="BackgroundArt" Stretch="UniformToFill" Opacity="0.09"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Background="#D207050E"/>
                <Ellipse Width="1040" Height="770" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.12" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#BA42EE" Offset="0"/>
                            <GradientStop Color="#26133B" Offset="0.6"/>
                            <GradientStop Color="#08060E" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Canvas Panel.ZIndex="20">
                    <Border x:Name="MachineCabinet" Canvas.Left="28" Canvas.Top="20" Width="1704" Height="920"
                            Background="{StaticResource NineLivesEnamel}" BorderBrush="{StaticResource NineLivesIris}" BorderThickness="4" CornerRadius="42"/>

                    <!-- Engraved inlays and corner filigree sit on top of the illustrated casing. -->
                    <Border Canvas.Left="38" Canvas.Top="29" Width="1684" Height="902"
                            Background="#08000000" BorderBrush="#B2826592" BorderThickness="1" CornerRadius="34"
                            IsHitTestVisible="False"/>
                    <Path Data="M 57,112 Q 57,43 123,43 M 1637,43 Q 1703,43 1703,112"
                          Stroke="{StaticResource NineLivesGold}" StrokeThickness="2" Opacity="0.8"
                          IsHitTestVisible="False"/>
                    <Path Data="M 66,132 Q 244,127 380,132 M 1380,132 Q 1516,127 1694,132"
                          Stroke="{StaticResource NineLivesGold}" StrokeThickness="1.8" Opacity="0.65"
                          IsHitTestVisible="False"/>
                    <Path Data="M 66,852 Q 350,850 710,852 M 1050,852 Q 1410,850 1694,852"
                          Stroke="{StaticResource NineLivesIris}" StrokeThickness="1.7" Opacity="0.7"
                          IsHitTestVisible="False"/>
                    <!-- Header -->
                    <Button x:Name="CasinoButton" Canvas.Left="70" Canvas.Top="56" Width="174" Height="52"
                            Style="{StaticResource ChromeButton}" Content="←  CASINO"
                            Click="CasinoButton_Click" ToolTip="Back to Casino (Esc)"/>
                    <StackPanel Canvas.Left="538" Canvas.Top="37" Width="684">
                        <TextBlock Text="NINE LIVES" HorizontalAlignment="Center" Foreground="#F2CF75"
                                   FontFamily="Georgia" FontSize="47" FontWeight="Bold"/>
                        <TextBlock Text="HIGH VOLATILITY · 3×3 · FIVE LINES" HorizontalAlignment="Center"
                                   Foreground="#AFA0BB" FontFamily="Segoe UI Semibold" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource HudPanel}" Canvas.Left="1315" Canvas.Top="54" Width="155" Height="58">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="#F0B34F" FontSize="19" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="BANKROLL" Style="{StaticResource PanelLabel}" FontSize="9"/>
                                <TextBlock x:Name="BankrollText" Style="{StaticResource HudText}" FontSize="19"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HudPanel}" Canvas.Left="1482" Canvas.Top="54" Width="129" Height="58">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="★" Foreground="#D75CFF" FontSize="18" Margin="0,0,7,0"/>
                            <StackPanel>
                                <TextBlock Text="PROFILE" Style="{StaticResource PanelLabel}" FontSize="9"/>
                                <TextBlock x:Name="LevelText" Style="{StaticResource HudText}" FontSize="17"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Canvas.Left="1624" Canvas.Top="54" Width="67" Height="58"
                            Style="{StaticResource ChromeButton}" Padding="0" Content="SET"
                            Click="SettingsFlyoutButton_Click" ToolTip="Nine Lives settings"/>

                    <!-- Feature rail -->
                    <Border Canvas.Left="70" Canvas.Top="147" Width="330" Height="675"
                            Background="{StaticResource NineLivesEnamel}" BorderBrush="{StaticResource NineLivesIris}" BorderThickness="2.2" CornerRadius="24">
                        <StackPanel Margin="26">
                            <TextBlock Text="THE GAME" Style="{StaticResource PanelLabel}" Foreground="#C46DF0"/>
                            <TextBlock Text="One dangerous cat. Five lines. No quiet wins."
                                       Foreground="#F4EAF8" FontFamily="Georgia" FontSize="20" TextWrapping="Wrap"
                                       Margin="0,11,0,22"/>
                            <Border Height="1.5" Background="{StaticResource NineLivesGold}" Opacity="0.55" Margin="0,0,0,20"/>
                            <TextBlock Text="POUNCE WILD" Foreground="#E7BE62" FontFamily="Segoe UI Semibold" FontSize="14"/>
                            <TextBlock Text="The black cat can strike a second cell after the reels stop."
                                       Foreground="#AFA0B9" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,20"/>
                            <TextBlock Text="NINE LIVES" Foreground="#D66BFF" FontFamily="Segoe UI Semibold" FontSize="14"/>
                            <TextBlock Text="Three bonus symbols wake nine bonus spins."
                                       Foreground="#AFA0B9" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,20"/>
                            <TextBlock Text="FULL GRID" Foreground="#E7BE62" FontFamily="Segoe UI Semibold" FontSize="14"/>
                            <TextBlock Text="A complete matching 3×3 grid pays 5,000×."
                                       Foreground="#AFA0B9" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,20"/>
                            <Border Height="1.5" Background="{StaticResource NineLivesGold}" Opacity="0.55" Margin="0,0,0,18"/>
                            <TextBlock Text="WINS" Style="{StaticResource PanelLabel}"/>
                            <TextBlock Text="Winning symbols glow while the full line sweeps across the grid."
                                       Foreground="#81758B" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Reel stage: sized around the authored reel coordinates through Y≈808 -->
                    <Border Canvas.Left="421" Canvas.Top="147" Width="918" Height="675"
                            Background="{StaticResource NineLivesEnamel}" BorderBrush="{StaticResource NineLivesGold}" BorderThickness="3" CornerRadius="29">
                        <Border.Effect>
                            <DropShadowEffect Color="#8E42C7" BlurRadius="28" ShadowDepth="0" Opacity="0.24"/>
                        </Border.Effect>
                    </Border>
                    <Border Canvas.Left="432" Canvas.Top="158" Width="896" Height="653"
                            Background="#44090513" BorderBrush="#8159567E" BorderThickness="1.5" CornerRadius="22"/>
                    <!-- Architectural columns frame the square artworks without covering them. -->
                    <Border Canvas.Left="460" Canvas.Top="179" Width="3" Height="615"
                            Background="{StaticResource NineLivesGold}" Opacity="0.48" IsHitTestVisible="False"/>
                    <Border Canvas.Left="1296" Canvas.Top="179" Width="3" Height="615"
                            Background="{StaticResource NineLivesGold}" Opacity="0.48" IsHitTestVisible="False"/>
                    <Path Data="M 471,210 Q 494,187 525,210 M 1235,210 Q 1266,187 1289,210
                                M 471,757 Q 494,780 525,757 M 1235,757 Q 1266,780 1289,757"
                          Stroke="{StaticResource NineLivesIris}" StrokeThickness="2.5" Opacity="0.85"
                          IsHitTestVisible="False"/>
                    <TextBlock Canvas.Left="467" Canvas.Top="389" Width="77" Text="IX"
                               Foreground="#558C6A8D" FontFamily="Georgia" FontWeight="Bold"
                               FontSize="62" TextAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Canvas.Left="1215" Canvas.Top="389" Width="77" Text="✦"
                               Foreground="#56CC9F7E" FontFamily="Georgia"
                               FontSize="62" TextAlignment="Center" IsHitTestVisible="False"/>
                    <Canvas x:Name="ReelCanvas" Canvas.Left="0" Canvas.Top="0" Width="1760" Height="960"/>
                    <local:NineLivesWinCanvas x:Name="WinLineCanvas" Canvas.Left="0" Canvas.Top="0"
                                              Width="1760" Height="960" IsHitTestVisible="False"/>

                    <Border x:Name="BonusBadge" Canvas.Left="696" Canvas.Top="114" Width="368" Height="38"
                            Background="#E31A1024" BorderBrush="#E7B95E" BorderThickness="1" CornerRadius="15"
                            Visibility="Collapsed">
                        <TextBlock x:Name="BonusText" Style="{StaticResource HudText}" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Info rail -->
                    <Border Canvas.Left="1360" Canvas.Top="147" Width="330" Height="675"
                            Background="{StaticResource NineLivesEnamel}" BorderBrush="{StaticResource NineLivesIris}" BorderThickness="2.2" CornerRadius="24">
                        <StackPanel Margin="26">
                            <TextBlock Text="TABLE INFO" Style="{StaticResource PanelLabel}" Foreground="#C46DF0"/>
                            <Grid Margin="0,16,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="5" Foreground="#F3D06E" FontFamily="Georgia" FontSize="30" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PAYLINES" Style="{StaticResource PanelLabel}" FontSize="9" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="9" Foreground="#D66BFF" FontFamily="Georgia" FontSize="30" HorizontalAlignment="Center"/>
                                    <TextBlock Text="BONUS SPINS" Style="{StaticResource PanelLabel}" FontSize="9" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1.5" Background="{StaticResource NineLivesGold}" Opacity="0.55" Margin="0,2,0,18"/>
                            <TextBlock Text="VOLATILITY" Style="{StaticResource PanelLabel}"/>
                            <TextBlock Text="HIGH" Foreground="#F3D06E" FontFamily="Georgia" FontSize="25" Margin="0,4,0,15"/>
                            <TextBlock Text="MAX WIN" Style="{StaticResource PanelLabel}"/>
                            <TextBlock Text="5,000×" Foreground="#F6E4AC" FontFamily="Georgia" FontSize="25" Margin="0,4,0,18"/>
                            <Border Height="1.5" Background="{StaticResource NineLivesGold}" Opacity="0.55" Margin="0,0,0,18"/>
                            <TextBlock Text="MIDNIGHT FORTUNE" Style="{StaticResource PanelLabel}" Foreground="#E4BE7B"/>
                            <Border BorderBrush="{StaticResource NineLivesIris}" BorderThickness="1.3"
                                    Background="#47170F2D" CornerRadius="15" Margin="0,12,0,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="✦  LEGENDARY HITS" Foreground="#F3D490"
                                               FontFamily="Georgia" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="Winning symbols illuminate the reel and trace their payline."
                                               Foreground="#C9B8D1" FontSize="13" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- Status never overlaps the third reel row -->
                    <Border x:Name="StatusBadge" Canvas.Left="520" Canvas.Top="824" Width="720" Height="30"
                            Background="{StaticResource NineLivesEnamel}" BorderBrush="{StaticResource NineLivesIris}" BorderThickness="1.5" CornerRadius="14">
                        <Grid>
                            <Ellipse Width="7" Height="7" Fill="#C34FFF" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                            <TextBlock x:Name="StatusText" Text="Five lines. Three reels. One dangerous cat."
                                       Foreground="#EEDFF4" FontFamily="Segoe UI Semibold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Bottom control deck uses a real Grid so controls cannot overlap -->
                    <Border x:Name="NineLivesFooter" Canvas.Left="70" Canvas.Top="860" Width="1620" Height="70"
                            Background="{StaticResource NineLivesEnamel}" BorderBrush="{StaticResource NineLivesGold}" BorderThickness="2" CornerRadius="21">
                        <Grid Margin="16,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165"/><ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="58"/><ColumnDefinition Width="138"/><ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="19"/><ColumnDefinition Width="154"/><ColumnDefinition Width="19"/>
                                <ColumnDefinition Width="232"/><ColumnDefinition Width="19"/>
                                <ColumnDefinition Width="155"/><ColumnDefinition Width="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="InfoButton" Grid.Column="0" Style="{StaticResource ChromeButton}"
                                    Content="PAYTABLE" Click="PaytableButton_Click" ToolTip="Paytable"/>
                            <Button x:Name="BetDownButton" Grid.Column="2" Style="{StaticResource ChromeButton}" Content="−"
                                    FontSize="22" Padding="0" Click="BetDownButton_Click" ToolTip="Lower bet"/>
                            <Border Grid.Column="3" Style="{StaticResource HudPanel}" Margin="7,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="BET" Style="{StaticResource PanelLabel}" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BetText" Style="{StaticResource HudText}" FontSize="22" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BetUpButton" Grid.Column="4" Style="{StaticResource ChromeButton}" Content="+"
                                    FontSize="21" Padding="0" Click="BetUpButton_Click" ToolTip="Raise bet"/>
                            <Button x:Name="AutoButton" Grid.Column="6" Style="{StaticResource ChromeButton}" Content="AUTO ×20"
                                    Click="AutoButton_Click" ToolTip="Auto spin"/>
                            <Button x:Name="SpinButton" Grid.Column="8" Style="{StaticResource SpinButtonStyle}" Content="SPIN"
                                    Click="SpinButton_Click" ToolTip="Spin"/>
                            <Button x:Name="MaxButton" Grid.Column="10" Style="{StaticResource GoldButton}" Content="MAX BET"
                                    Click="MaxButton_Click" ToolTip="Maximum affordable bet"/>
                            <Border Grid.Column="12" Style="{StaticResource HudPanel}" Margin="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="LAST WIN" Style="{StaticResource PanelLabel}" FontSize="9" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="WinText" Style="{StaticResource HudText}" FontSize="21" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="MenuButton" Grid.Column="12" Visibility="Collapsed" Style="{StaticResource ChromeButton}" Content="← CASINO"
                                    Click="CasinoButton_Click" ToolTip="Back to Casino"/>
                        </Grid>
                    </Border>

                    <!-- Custom themed settings flyout; no native Windows ContextMenu -->
                    <Border x:Name="SettingsFlyout" Canvas.Left="1461" Canvas.Top="120" Width="228" Height="176"
                            Visibility="Collapsed" Panel.ZIndex="80" Background="#FC0D0916"
