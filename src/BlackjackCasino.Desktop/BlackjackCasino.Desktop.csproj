<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Windows desktop client for Blackjack Casino.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Portraits\*.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlackjackCasino.Core\BlackjackCasino.Core.csproj" />
    <ProjectReference Include="..\BlackjackCasino.Update\BlackjackCasino.Update.csproj" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Music/*.wav" LogicalName="BlackjackCasino.Music.%(Filename)%(Extension)" /></ItemGroup>
</Project>
