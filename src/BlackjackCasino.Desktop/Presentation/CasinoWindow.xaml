<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:BlackjackCasino.Desktop">
  <Style x:Key="CasinoCaptionButton" TargetType="Button">
    <Setter Property="Width" Value="44"/><Setter Property="Height" Value="33"/>
    <Setter Property="Foreground" Value="#DFCEAA"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="18"/><Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#3B5945"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#64754C"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="CasinoWindowTemplate" TargetType="Window">
    <Border x:Name="CasinoWindowBorder" BorderBrush="#49604A" BorderThickness="1" Background="{TemplateBinding Background}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="CasinoTitleBar" Height="34" BorderBrush="#48523B" BorderThickness="0,0,0,1">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B3529"/><GradientStop Color="#0A1813" Offset="1"/></LinearGradientBrush></Border.Background>
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CasinoMinimize" Content="─" ToolTip="Minimize" Style="{StaticResource CasinoCaptionButton}"/>
              <Button x:Name="CasinoMaximize" Content="□" ToolTip="Maximize / Restore" Style="{StaticResource CasinoCaptionButton}"/>
              <Button x:Name="CasinoClose" Content="×" ToolTip="Close" Style="{StaticResource CasinoCaptionButton}"/>
            </StackPanel>
            <Image Source="{TemplateBinding Icon}" Width="22" Height="22" Margin="12,0,9,0" DockPanel.Dock="Left"/>
            <TextBlock Text="{TemplateBinding Title}" Foreground="#E4D2AD" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>
        <AdornerDecorator Grid.Row="1"><ContentPresenter/></AdornerDecorator>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="local:CasinoWindowFrame.IsFullscreen" Value="True"><Setter TargetName="CasinoTitleBar" Property="Visibility" Value="Collapsed"/><Setter TargetName="CasinoWindowBorder" Property="BorderThickness" Value="0"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
