<Window x:Class="BlackjackCasino.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackjack Casino — Phase 1"
        Width="920"
        Height="600"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#071B11"
        Foreground="#F4F0E6">
  <Grid Margin="36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="BLACKJACK CASINO"
                 FontSize="30"
                 FontWeight="Bold" />
      <TextBlock Text="Phase 1 foundation build"
                 Margin="0,8,0,0"
                 FontSize="15"
                 Foreground="#B8C9BE" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,34,0,34"
            Padding="28"
            CornerRadius="12"
            Background="#0D2A1B"
            BorderBrush="#28583B"
            BorderThickness="1">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Core engine + updater are online."
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="#C9D6CD"
                   FontSize="15"
                   Text="The playable table arrives in Phase 2. This shell exists now so releases and the update path can be exercised from day one." />

        <Separator Margin="0,28" Background="#28583B" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Installed version" Foreground="#9CB2A4" />
          <TextBlock x:Name="VersionText" Grid.Column="1" Margin="24,0,0,0" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="Update status" Foreground="#9CB2A4" />
          <TextBlock x:Name="UpdateStatusText" Grid.Row="1" Grid.Column="1" Margin="24,12,0,0" Text="Not checked yet" />
        </Grid>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CheckUpdateButton"
              Width="150"
              Height="38"
              Margin="0,0,12,0"
              Content="Check for updates"
              Click="CheckUpdateButton_Click" />
      <Button x:Name="InstallUpdateButton"
              Width="170"
              Height="38"
              Content="Install update"
              IsEnabled="False"
              Click="InstallUpdateButton_Click" />
    </StackPanel>
  </Grid>
</Window>
