<Window x:Class="BlackjackCasino.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blackjack Casino"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#07150E"
        Foreground="#F3EFE4"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#D4A84F" />
      <Setter Property="Foreground" Value="#16130C" />
      <Setter Property="BorderBrush" Value="#F0CD7A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#163D29" />
      <Setter Property="Foreground" Value="#F3EFE4" />
      <Setter Property="BorderBrush" Value="#37694C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinWidth" Value="105" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="MutedButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#102A1D" />
      <Setter Property="Foreground" Value="#C7D4CB" />
      <Setter Property="MinWidth" Value="80" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="290" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.ColumnSpan="2" Background="#091B12" BorderBrush="#244531" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="BLACKJACK CASINO" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Single-player table" FontSize="11" Foreground="#8FAA98" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,28,0">
          <TextBlock Text="BANKROLL" FontSize="10" Foreground="#8FAA98" HorizontalAlignment="Right" />
          <TextBlock x:Name="BankrollText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="VERSION" FontSize="10" Foreground="#8FAA98" HorizontalAlignment="Right" />
          <TextBlock x:Name="VersionText" FontSize="13" Foreground="#D5DED8" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="#0A291A">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="24,22,24,6" HorizontalAlignment="Center">
        <TextBlock Text="DEALER" FontSize="12" FontWeight="Bold" Foreground="#9EB1A4" HorizontalAlignment="Center" />
        <StackPanel x:Name="DealerCardsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5" />
        <TextBlock x:Name="DealerValueText" FontSize="13" Foreground="#D4DED7" HorizontalAlignment="Center" />
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20,8">
          <StackPanel x:Name="PlayerHandsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>
        <Border Grid.Row="1" Margin="80,8,80,14" Padding="12,8" Background="#071D13" CornerRadius="8">
          <TextBlock x:Name="StatusText" Text="Place a bet to begin." TextAlignment="Center" FontSize="15" Foreground="#E8E2D4" TextWrapping="Wrap" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="2" x:Name="InsurancePanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,8">
        <TextBlock Text="Dealer shows an Ace. Insurance?" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#E8D4A4" />
        <Button Content="Take Insurance" Style="{StaticResource PrimaryButton}" Click="TakeInsurance_Click" />
        <Button Content="No Insurance" Style="{StaticResource MutedButton}" Click="DeclineInsurance_Click" />
      </StackPanel>

      <StackPanel Grid.Row="3" x:Name="ActionPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,0,16,20">
        <Button x:Name="HitButton" Content="HIT  [H]" Style="{StaticResource ActionButton}" Click="Hit_Click" />
        <Button x:Name="StandButton" Content="STAND  [S]" Style="{StaticResource ActionButton}" Click="Stand_Click" />
        <Button x:Name="DoubleButton" Content="DOUBLE  [D]" Style="{StaticResource ActionButton}" Click="Double_Click" />
        <Button x:Name="SplitButton" Content="SPLIT  [P]" Style="{StaticResource ActionButton}" Click="Split_Click" />
        <Button x:Name="SurrenderButton" Content="SURRENDER  [R]" Style="{StaticResource ActionButton}" Click="Surrender_Click" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Grid.Column="1" Background="#091B12" BorderBrush="#244531" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <TextBlock Text="BETTING" FontSize="12" FontWeight="Bold" Foreground="#9EB1A4" />
          <TextBlock x:Name="BetText" Text="$0" FontSize="28" FontWeight="Bold" Margin="0,7,0,12" />

          <UniformGrid Columns="2">
            <Button Content="+$5" Tag="5" Style="{StaticResource MutedButton}" Click="Chip_Click" />
            <Button Content="+$25" Tag="25" Style="{StaticResource MutedButton}" Click="Chip_Click" />
            <Button Content="+$100" Tag="100" Style="{StaticResource MutedButton}" Click="Chip_Click" />
            <Button Content="+$500" Tag="500" Style="{StaticResource MutedButton}" Click="Chip_Click" />
          </UniformGrid>
          <Button x:Name="ClearBetButton" Content="Clear Bet" Style="{StaticResource MutedButton}" Click="ClearBet_Click" />
          <Button x:Name="DealButton" Content="DEAL  [ENTER]" Style="{StaticResource PrimaryButton}" Height="44" Margin="4,8,4,0" Click="Deal_Click" />

          <Separator Margin="0,22" Background="#31533F" />

          <TextBlock Text="TABLE" FontSize="12" FontWeight="Bold" Foreground="#9EB1A4" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Shoe" Foreground="#8FAA98" />
            <TextBlock x:Name="ShoeText" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="Rules" Foreground="#8FAA98" Margin="0,7,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="6D · S17" Margin="0,7,0,0" />
            <TextBlock Grid.Row="2" Text="Blackjack" Foreground="#8FAA98" Margin="0,7,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="3:2" Margin="0,7,0,0" />
            <TextBlock Grid.Row="3" Text="Surrender" Foreground="#8FAA98" Margin="0,7,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="Late" Margin="0,7,0,0" />
          </Grid>

          <Button x:Name="ResetBankrollButton" Content="Reset bankroll to $1,000" Style="{StaticResource MutedButton}" Margin="4,14,4,0" Click="ResetBankroll_Click" />

          <Separator Margin="0,22" Background="#31533F" />

          <TextBlock Text="UPDATES" FontSize="12" FontWeight="Bold" Foreground="#9EB1A4" />
          <ComboBox x:Name="UpdateChannelComboBox" SelectedIndex="0" Margin="4,10,4,4">
            <ComboBoxItem Content="Stable" />
            <ComboBoxItem Content="Development" />
          </ComboBox>
          <TextBlock x:Name="UpdateStatusText" Text="Not checked yet" Margin="4,6" Foreground="#AFC0B4" TextWrapping="Wrap" FontSize="12" />
          <Button x:Name="CheckUpdateButton" Content="Check for updates" Style="{StaticResource MutedButton}" Click="CheckUpdateButton_Click" />
          <Button x:Name="InstallUpdateButton" Content="Install update" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="InstallUpdateButton_Click" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
