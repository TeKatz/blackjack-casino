; Engine configuration file.
config_version=5

[application]
config/name="Midnight Descent"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://art/descent.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
; Keep Controls pixel-aligned; leave world transforms unsnapped so the
; smooth chamber camera and animated pixel world do not jitter.

window/size/mode=2

[gui]
common/snap_controls_to_pixels=true

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.025, 0.075, 1)
